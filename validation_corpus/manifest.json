{
  "version": 1,
  "description": "Tiny deterministic HIRAX-style regression corpus for observatory validation.",
  "datasets": [
    {
      "id": "clean_observation",
      "category": "clean observations",
      "file": "clean_observation.h5",
      "observation_metadata_summary": {
        "instrument": "HIRAX",
        "n_antennas": 4,
        "n_baselines": 4,
        "has_uv_coordinates": true,
        "has_calibration_metadata": true,
        "has_timestamp": true
      },
      "expected_scientific_behavior": "Physically reasonable outputs with stable uv, closure, calibration, and RFI diagnostics.",
      "preferred_dataset_path": "visibilities",
      "target_freq_bins": 32
    },
    {
      "id": "noisy_observation",
      "category": "noisy observations",
      "file": "noisy_observation.h5",
      "observation_metadata_summary": {
        "instrument": "HIRAX",
        "n_antennas": 4,
        "n_baselines": 4,
        "has_uv_coordinates": true,
        "has_calibration_metadata": true,
        "has_timestamp": true
      },
      "expected_scientific_behavior": "Outputs remain physically reasonable but with higher noise floor and reduced confidence.",
      "preferred_dataset_path": "visibilities",
      "target_freq_bins": 32
    },
    {
      "id": "rfi_heavy_session",
